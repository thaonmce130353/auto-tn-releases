{
  // Buyer site on Cloudflare Workers: the repo root is the static site (guide page, icons); worker.mjs serves the PC zips and
  // VERSIONS.md from the R2 bucket that the admin page fills on every release. Every push to main rebuilds and redeploys it.
  "name": "auto-tn-releases",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/tn-extension-*", "/VERSIONS.md"]
  },
  // Create the bucket first: dashboard → R2 → Create bucket "auto-tn-zips" (the admin Worker binds the same bucket).
  "r2_buckets": [
    { "binding": "ZIPS", "bucket_name": "auto-tn-zips" }
  ],
  // Preview builds (PR checks) get NO bindings or variables on purpose: previews must never touch production data. Wrangler requires the block, even empty.
  "previews": {}
}
